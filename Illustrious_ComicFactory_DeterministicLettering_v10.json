      "title": "Layout Map",
      "properties": {},
      "widgets_values": [
        "## 1600 x 2200 page\n\n| Panel | Position | Size |\n|---|---:|---:|\n| 1 | 60, 60 | 720 x 960 |\n| 2 | 820, 60 | 720 x 960 |\n| 3 | 60, 1120 | 720 x 960 |\n| 4 | 820, 1120 | 720 x 960 |\n\nThe white margins and gutters are generated before compositing. Change the coordinates to create asymmetric manga layouts without touching the sampling branches."
      ],
      "color": "#222",
      "bgcolor": "#000"
    },
